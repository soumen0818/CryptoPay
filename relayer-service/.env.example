# Blockchain Configuration (Polygon Amoy Testnet)
EXPO_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
EXPO_PUBLIC_CHAIN_ID=80002
EXPO_PUBLIC_TOKEN_ADDRESS=0xYourTokenAddressAfterDeployment

# Relayer Wallet (KEEP SECRET - This wallet pays gas fees)
# Get from MetaMask: Settings → Security & Privacy → Reveal Private Key
# IMPORTANT: Create a NEW wallet specifically for the relayer
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
API_KEY=cryptopay_relay_2026_your_secret_key_here
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email Alerts (for low balance notifications)
# Gmail Setup: 
#   1. Enable 2FA in your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create "App Password" for "Mail"
#   4. Use that 16-character password below
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password-here
ALERT_EMAIL=admin@example.com
LOW_BALANCE_THRESHOLD=1
