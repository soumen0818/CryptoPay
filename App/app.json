{
  "expo": {
    "name": "CryptoPay",
    "slug": "cryptopay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cryptopay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CryptoPay needs camera access to scan QR codes for payments",
        "NSLocationWhenInUseUsageDescription": "CryptoPay uses your location to secure transactions",
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely access your wallet"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.cryptopay.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CryptoPay needs camera access to scan QR codes for payments"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CryptoPay uses your location to secure transactions"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to quickly and securely access your wallet"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3c7a4ef7-ad99-42d0-8b88-0ee8e28542c9"
      }
    }
  }
}
