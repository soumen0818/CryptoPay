{
  "expo": {
    "name": "C-Pay",
    "slug": "cpay",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/cpay_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/cpay_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cpay.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "C-Pay needs camera access to scan QR codes for payments",
        "NSLocationWhenInUseUsageDescription": "C-Pay uses your location to secure transactions",
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely access your wallet"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/cpay_logo.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.cpay.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/cpay_logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "C-Pay needs camera access to scan QR codes for payments"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "C-Pay uses your location to secure transactions"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to quickly and securely access your wallet"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow C-Pay to save QR codes to your photos.",
          "savePhotosPermission": "Allow C-Pay to save QR codes to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3c7a4ef7-ad99-42d0-8b88-0ee8e28542c9"
      },
      "EXPO_PUBLIC_RPC_URL": "https://rpc-amoy.polygon.technology",
      "EXPO_PUBLIC_CHAIN_ID": "80002",
      "EXPO_PUBLIC_TOKEN_ADDRESS": "0x98BE2863435E05d9E6FF8A488A54Be9aA2a0469b",
      "EXPO_PUBLIC_RELAYER_URL": "https://cryptopay-relayer.onrender.com"
    }
  }
}
