# Supabase Configuration (FREE Tier)
# Get these from https://supabase.com > Your Project > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Blockchain Configuration (Polygon Amoy Testnet)
EXPO_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
EXPO_PUBLIC_CHAIN_ID=80002
EXPO_PUBLIC_TOKEN_ADDRESS=0xYourTokenAddressAfterDeployment

# Relayer Service URL (for gasless transactions)
EXPO_PUBLIC_RELAYER_URL=https://your-relayer-service.com
